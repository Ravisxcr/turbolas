from __future__ import annotations

from typing import Final

__version__: str

class LASSectionError(ValueError): ...
class LASHeaderError(ValueError): ...

class SectionType:
    VERSION: Final[SectionType]
    WELL: Final[SectionType]
    CURVE: Final[SectionType]
    PARAMETER: Final[SectionType]
    OTHER: Final[SectionType]
    ASCII: Final[SectionType]

    Version: Final[SectionType]
    Well: Final[SectionType]
    Curve: Final[SectionType]
    Parameter: Final[SectionType]
    Other: Final[SectionType]
    Ascii: Final[SectionType]

    @property
    def char_code(self) -> str: ...
    @property
    def delimiter(self) -> str: ...
    @property
    def name(self) -> str: ...
    @property
    def description(self) -> str: ...
    @property
    def is_mandatory(self) -> bool: ...
    @property
    def is_optional(self) -> bool: ...
    @property
    def is_header_section(self) -> bool: ...
    @property
    def is_data_section(self) -> bool: ...
    @property
    def is_remarks_section(self) -> bool: ...

class State:
    INITIAL: Final[State]
    VERSION: Final[State]
    WELL: Final[State]
    CURVE: Final[State]
    PARAMETER: Final[State]
    OTHER: Final[State]
    ASCII: Final[State]
    COMPLETE: Final[State]

    Initial: Final[State]
    Version: Final[State]
    Well: Final[State]
    Curve: Final[State]
    Parameter: Final[State]
    Other: Final[State]
    Ascii: Final[State]
    Complete: Final[State]

    @property
    def section_type(self) -> SectionType | None: ...
    @property
    def name(self) -> str: ...
    @property
    def is_initial(self) -> bool: ...
    @property
    def is_in_section(self) -> bool: ...
    @property
    def is_in_data(self) -> bool: ...
    @property
    def is_complete(self) -> bool: ...

class ValidationMode:
    STRICT: Final[ValidationMode]
    PERMISSIVE: Final[ValidationMode]
    Strict: Final[ValidationMode]
    Permissive: Final[ValidationMode]

    @property
    def is_strict(self) -> bool: ...
    @property
    def is_permissive(self) -> bool: ...

class SectionDelimiter:
    @property
    def section_type(self) -> SectionType: ...
    @property
    def char_code(self) -> str: ...
    @property
    def line_number(self) -> int: ...
    @property
    def raw_line(self) -> str: ...
    @property
    def title(self) -> str: ...
    @staticmethod
    def is_delimiter(line: str) -> bool: ...
    @staticmethod
    def is_comment(line: str) -> bool: ...
    @staticmethod
    def is_blank(line: str) -> bool: ...
    @staticmethod
    def parse_line(line: str, line_number: int = 1) -> SectionDelimiter: ...

class PyLineAction:
    @property
    def action_type(self) -> str: ...
    @property
    def section(self) -> SectionType | None: ...
    @property
    def delimiter(self) -> SectionDelimiter | None: ...
    @property
    def text(self) -> str | None: ...
    @property
    def is_section_start(self) -> bool: ...
    @property
    def is_comment(self) -> bool: ...
    @property
    def is_blank(self) -> bool: ...
    @property
    def is_content(self) -> bool: ...

class SectionStateMachine:
    def __init__(self, strict: bool = True, mode: ValidationMode | None = None) -> None: ...
    @property
    def current_state(self) -> State: ...
    @property
    def current_state_name(self) -> str: ...
    @property
    def current_section(self) -> SectionType | None: ...
    @property
    def mode(self) -> ValidationMode: ...
    @property
    def line_number(self) -> int: ...
    @property
    def total_lines_processed(self) -> int: ...
    @property
    def section_count(self) -> int: ...
    @property
    def seen_sections(self) -> list[SectionType]: ...
    @property
    def current_delimiter(self) -> SectionDelimiter | None: ...
    @property
    def current_section_line_count(self) -> int: ...
    @property
    def is_in_data_section(self) -> bool: ...
    @property
    def is_complete(self) -> bool: ...
    def has_seen_section(self, section: SectionType) -> bool: ...
    def get_line_count_for_section(self, section: SectionType) -> int: ...
    def process_line(self, line: str) -> PyLineAction: ...
    def feed_line(self, line: str) -> SectionType | None: ...
    def transition(self, delimiter: SectionDelimiter) -> State: ...
    def transition_to(self, section: SectionType) -> State: ...
    def finish(self) -> None: ...
    def reset(self) -> None: ...
    def parse_header_line(self, line: str) -> HeaderItem: ...
    @property
    def null_sentinel(self) -> NullSentinel: ...
    @null_sentinel.setter
    def null_sentinel(self, value: NullSentinel) -> None: ...
    @property
    def null_value(self) -> float: ...
    @property
    def is_null_detected(self) -> bool: ...
    def parse_data_line(self, line: str) -> list[float]: ...

class HeaderItem:
    def __init__(
        self,
        mnemonic: str,
        unit: str = ...,
        value: str = ...,
        description: str = ...,
        line_number: int = 1,
        raw_line: str = ...,
    ) -> None: ...
    @property
    def mnemonic(self) -> str: ...
    @property
    def unit(self) -> str: ...
    @property
    def value(self) -> str: ...
    @property
    def description(self) -> str: ...
    @property
    def descr(self) -> str: ...
    @property
    def raw_line(self) -> str: ...
    @property
    def line_number(self) -> int: ...
    @property
    def has_unit(self) -> bool: ...
    @property
    def is_empty_value(self) -> bool: ...
    @property
    def has_description(self) -> bool: ...
    @property
    def is_null_record(self) -> bool: ...
    def is_null(self, sentinel: NullSentinel | None = None) -> bool: ...
    def as_float(self) -> float | None: ...
    def as_float_mapped(self, sentinel: NullSentinel | None = None) -> float | None: ...
    def as_int(self) -> int | None: ...
    def as_bool(self) -> bool | None: ...
    def unquoted_value(self) -> str: ...
    def format_line(
        self,
        mnem_width: int | None = None,
        unit_width: int | None = None,
        val_width: int | None = None,
    ) -> str: ...
    def to_line(self) -> str: ...
    @staticmethod
    def parse_line(
        line: str,
        line_number: int = 1,
        mode: ValidationMode | None = None,
    ) -> HeaderItem: ...
    @staticmethod
    def try_parse_line(
        line: str,
        line_number: int = 1,
        mode: ValidationMode | None = None,
    ) -> HeaderItem | None: ...
    @staticmethod
    def is_header_line(line: str) -> bool: ...
    @staticmethod
    def is_comment(line: str) -> bool: ...
    @staticmethod
    def is_blank(line: str) -> bool: ...

class HeaderParser:
    def __init__(
        self,
        mode: ValidationMode | None = None,
        strict: bool | None = None,
    ) -> None: ...
    @property
    def mode(self) -> ValidationMode: ...
    @mode.setter
    def mode(self, value: ValidationMode) -> None: ...
    @property
    def is_strict(self) -> bool: ...
    @property
    def is_permissive(self) -> bool: ...
    def parse_line(self, line: str, line_number: int = 1) -> HeaderItem: ...
    def parse_lines(self, lines: list[str], start_line_number: int = 1) -> list[HeaderItem]: ...

class NullPolicy:
    STRICT: Final[NullPolicy]
    COMMON: Final[NullPolicy]
    AGGRESSIVE: Final[NullPolicy]
    NONE: Final[NullPolicy]

    Strict: Final[NullPolicy]
    Common: Final[NullPolicy]
    Aggressive: Final[NullPolicy]
    None_: Final[NullPolicy]

    @property
    def is_strict(self) -> bool: ...
    @property
    def is_common(self) -> bool: ...
    @property
    def is_aggressive(self) -> bool: ...
    @property
    def is_none(self) -> bool: ...

class NullSentinel:
    def __init__(
        self,
        value: float = -999.25,
        policy: NullPolicy | None = None,
        tolerance: float = 1e-5,
        raw_sentinel: str | None = None,
    ) -> None: ...
    @property
    def value(self) -> float: ...
    @value.setter
    def value(self, val: float) -> None: ...
    @property
    def raw_sentinel(self) -> str | None: ...
    @raw_sentinel.setter
    def raw_sentinel(self, raw: str | None) -> None: ...
    @property
    def policy(self) -> NullPolicy: ...
    @policy.setter
    def policy(self, pol: NullPolicy) -> None: ...
    @property
    def tolerance(self) -> float: ...
    @tolerance.setter
    def tolerance(self, tol: float) -> None: ...
    @property
    def custom_substitutes(self) -> list[float]: ...
    def add_substitute(self, sub: float) -> None: ...
    def is_null(self, val: float) -> bool: ...
    def is_null_str(self, s: str) -> bool: ...
    def map_to_nan(self, val: float) -> float: ...
    def map_from_nan(self, val: float) -> float: ...
    def map_str_to_nan(self, s: str) -> float | None: ...
    def replace_nulls(self, data: list[float]) -> list[float]: ...
    def replace_nans(self, data: list[float]) -> list[float]: ...
    def parse_line(self, line: str) -> list[float]: ...
    def format_null(self) -> str: ...
    @staticmethod
    def default_cwls() -> NullSentinel: ...
    @staticmethod
    def from_item(item: HeaderItem) -> NullSentinel | None: ...
    @staticmethod
    def detect(lines: list[str]) -> NullSentinel | None: ...

def map_to_nan(val: float, sentinel: float = -999.25) -> float: ...
def map_from_nan(val: float, sentinel: float = -999.25) -> float: ...
def is_null(val: float, sentinel: float = -999.25) -> bool: ...
def parse_header_line(
    line: str,
    line_number: int = 1,
    mode: ValidationMode | None = None,
) -> HeaderItem: ...
